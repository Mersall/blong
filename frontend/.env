# BLONG Frontend Environment Configuration
# This file should be the SINGLE SOURCE OF TRUTH for all environment variables

# API Configuration
# Use machine IP for development - allows simulator/device connectivity
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.12:3000/api
EXPO_PUBLIC_API_BASE_URL_ANDROID=http://10.0.2.2:3000/api
EXPO_PUBLIC_API_BASE_URL_IOS=http://192.168.1.12:3000/api
EXPO_PUBLIC_API_TIMEOUT=10000

# Environment
EXPO_PUBLIC_NODE_ENV=development

# Feature Flags
EXPO_PUBLIC_ENABLE_MOCK_DATA=false
EXPO_PUBLIC_ENABLE_DEBUG_LOGS=true

# App Configuration
EXPO_PUBLIC_APP_NAME=BLONG
EXPO_PUBLIC_APP_VERSION=1.0.0

# Network Configuration
EXPO_PUBLIC_REQUEST_RETRY_ATTEMPTS=3
EXPO_PUBLIC_REQUEST_RETRY_DELAY=1000

# Cache Configuration
EXPO_PUBLIC_CACHE_STALE_TIME=300000
EXPO_PUBLIC_CACHE_GC_TIME=600000
