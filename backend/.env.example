# ========================================
# BLONG Backend Environment Configuration
# ========================================
# 
# SECURITY NOTICE: 
# - NEVER commit the actual .env file to version control
# - Generate strong, unique secrets for production
# - Use different secrets for different environments
# - Rotate secrets regularly in production
#
# Copy this file to .env and update with your actual values
# ========================================

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Using Prisma Accelerate for enhanced performance and connection pooling
# Get your API key from: https://console.prisma.io/
# Format: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY_HERE"

# ========================================
# JWT & AUTHENTICATION SECURITY
# ========================================
# CRITICAL: Generate cryptographically secure secrets for production
# Use: openssl rand -base64 64
# or: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"

# JWT Access Token Secret (minimum 32 characters, recommend 64+ characters)
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MIN_64_CHARS_FOR_PRODUCTION_USE"

# JWT Refresh Token Secret (must be different from JWT_SECRET)
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET_MIN_64_CHARS_FOR_PRODUCTION"

# Token expiration times
JWT_EXPIRES_IN="15m"           # Access token (short-lived for security)
JWT_REFRESH_EXPIRES_IN="7d"    # Refresh token (longer-lived)

# ========================================
# APPLICATION CONFIGURATION
# ========================================
NODE_ENV="development"         # Options: development, production, test
PORT=3000                      # Application port
API_PREFIX="api"               # API route prefix

# ========================================
# SECURITY CONFIGURATION
# ========================================
# Password hashing rounds (12+ recommended for production)
BCRYPT_ROUNDS=12

# Account lockout protection
MAX_LOGIN_ATTEMPTS=5           # Failed attempts before lockout
LOCKOUT_TIME_MINUTES=15        # Lockout duration in minutes

# ========================================
# FILE UPLOAD CONFIGURATION
# ========================================
MAX_FILE_SIZE=5242880          # 5MB in bytes
UPLOAD_PATH="./uploads"        # Upload directory path

# ========================================
# EMAIL SERVICE CONFIGURATION
# ========================================
# Required for email verification and password reset functionality
# Popular SMTP services: Gmail, SendGrid, Mailgun, Amazon SES

SMTP_HOST="smtp.your-provider.com"        # Your SMTP server
SMTP_PORT=587                             # Usually 587 for TLS, 465 for SSL
SMTP_USER="your-email@yourdomain.com"     # SMTP username
SMTP_PASS="your-app-specific-password"    # SMTP password or app password
FROM_EMAIL="noreply@yourdomain.com"       # From address for emails
FRONTEND_URL="http://localhost:8081"      # Frontend URL for email links

# ========================================
# REDIS CONFIGURATION
# ========================================
# Used for caching, session management, and rate limiting
# Local: redis://localhost:6379
# Remote: redis://username:password@host:port
REDIS_URL="redis://localhost:6379"

# ========================================
# RATE LIMITING CONFIGURATION
# ========================================
# General API rate limiting
RATE_LIMIT_WINDOW_MS=900000              # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100              # Max requests per window

# Authentication endpoint rate limiting (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000         # 15 minutes in milliseconds
AUTH_RATE_LIMIT_MAX_REQUESTS=5           # Max auth attempts per window

# ========================================
# CORS CONFIGURATION
# ========================================
# Comma-separated list of allowed origins
# Add your frontend URLs here
ALLOWED_ORIGINS="http://localhost:8081,http://192.168.1.11:8081,exp://192.168.1.11:8081"

# ========================================
# ERROR MONITORING
# ========================================
# Sentry DSN for error tracking and monitoring
# Get from: https://sentry.io/
SENTRY_DSN=""                            # Optional: Sentry DSN for error tracking

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL="info"                         # Options: error, warn, info, debug
LOG_FORMAT="json"                        # Options: json, simple
LOG_FILE_ENABLED="true"                  # Enable file logging
LOG_CONSOLE_ENABLED="true"               # Enable console logging

# ========================================
# FUTURE INTEGRATIONS
# ========================================
# Keycloak SSO (for future enterprise integration)
KEYCLOAK_URL=""                          # Keycloak server URL
KEYCLOAK_REALM=""                        # Keycloak realm name
KEYCLOAK_CLIENT_ID=""                    # Keycloak client ID
KEYCLOAK_CLIENT_SECRET=""                # Keycloak client secret

# ========================================
# HEALTH CHECK CONFIGURATION
# ========================================
HEALTH_CHECK_TIMEOUT=5000                # Health check timeout in ms
HEALTH_CHECK_MEMORY_THRESHOLD=0.8        # Memory usage alert threshold (0-1)