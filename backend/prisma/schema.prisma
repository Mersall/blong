// ============================================================================
// SAFETY & SECURITY MODELS
// ============================================================================

model SafetyReport {
  id                String              @id @default(cuid())
  reporterId        String
  reportedUserId    String
  category          SafetyReportCategory
  subcategory       String?
  description       String
  evidence          Json?               // URLs to evidence files/screenshots
  severity          SafetyReportSeverity @default(MEDIUM)
  status            SafetyReportStatus  @default(PENDING)
  adminNotes        String?
  resolution        String?
  submittedAt       DateTime            @default(now())
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  metadata          Json?               // Additional context data

  // Relations
  reporter          User                @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser      User                @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@map("safety_reports")
  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@index([category])
  @@index([submittedAt])
}

model UserBlock {
  id              String            @id @default(cuid())
  blockingUserId  String
  blockedUserId   String
  reason          UserBlockReason?
  description     String?
  blockedAt       DateTime          @default(now())
  expiresAt       DateTime?         // For temporary blocks
  isActive        Boolean           @default(true)

  // Relations
  blockingUser    User              @relation("BlockingUser", fields: [blockingUserId], references: [id], onDelete: Cascade)
  blockedUser     User              @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([blockingUserId, blockedUserId])
  @@map("user_blocks")
  @@index([blockingUserId])
  @@index([blockedUserId])
  @@index([isActive])
}

model VerificationRequest {
  id                String                    @id @default(cuid())
  userId            String
  verificationType  VerificationType
  status            VerificationRequestStatus @default(PENDING)
  submittedAt       DateTime                  @default(now())
  reviewedAt        DateTime?
  completedAt       DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  adminNotes        String?

  // Verification Data
  documentType      String?                   // ID type: passport, license, etc.
  documentImages    String[]                  @default([]) // URLs to document images
  selfieImage       String?                   // URL to selfie verification image
  livePhotoImage    String?                   // URL to live photo verification
  metadata          Json?                     // Additional verification data

  // Relations
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_requests")
  @@index([userId])
  @@index([status])
  @@index([verificationType])
  @@index([submittedAt])
}

model SafetyCheckIn {
  id              String                @id @default(cuid())
  userId          String
  status          SafetyCheckInStatus   @default(SAFE)
  location        Json?                 // { latitude, longitude, address }
  plannedDuration Int?                  // Minutes
  actualDuration  Int?                  // Minutes
  checkInTime     DateTime              @default(now())
  expectedEndTime DateTime?
  actualEndTime   DateTime?
  emergencyTriggered Boolean            @default(false)
  emergencyTime   DateTime?
  notes           String?
  metadata        Json?                 // Additional context

  // Relations
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("safety_check_ins")
  @@index([userId])
  @@index([status])
  @@index([checkInTime])
  @@index([emergencyTriggered])
}

model EmergencyContact {
  id              String            @id @default(cuid())
  userId          String
  name            String
  phoneNumber     String
  email           String?
  relationship    String            // "friend", "family", "partner", etc.
  isPrimary       Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
  @@index([userId])
  @@index([isPrimary])
  @@index([isActive])
}

