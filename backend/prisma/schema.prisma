generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                            String                  @id @default(cuid())
  email                                         String                  @unique
  phone                                         String?                 @unique
  firstName                                     String
  lastName                                      String
  dateOfBirth                                   DateTime
  gender                                        Gender
  profilePicture                                String?
  isVerified                                    Boolean                 @default(false)
  verificationStatus                            VerificationStatus      @default(PENDING)
  relationshipStatus                            RelationshipStatus      @default(SINGLE)
  preferredLanguage                             String?                 @default("en")
  currentPhase                                  String?                 @default("single")
  password                                      String
  resetToken                                    String?
  resetTokenExpiry                              DateTime?
  verificationToken                             String?
  verificationTokenExpiry                       DateTime?
  loginAttempts                                 Int                     @default(0)
  lockoutUntil                                  DateTime?
  createdAt                                     DateTime                @default(now())
  updatedAt                                     DateTime                @updatedAt
  article_bookmarks                             article_bookmarks[]
  article_read_history                          article_read_history[]
  date_feedbacks                                date_feedbacks[]
  date_interests                                date_interests[]
  date_payments                                 date_payments[]
  date_requests_date_requests_fromUserIdTousers date_requests[]         @relation("date_requests_fromUserIdTousers")
  date_requests_date_requests_toUserIdTousers   date_requests[]         @relation("date_requests_toUserIdTousers")
  date_schedules                                date_schedules[]
  delivered_dates                               delivered_dates[]
  matches_matches_fromUserIdTousers             matches[]               @relation("matches_fromUserIdTousers")
  matches_matches_toUserIdTousers               matches[]               @relation("matches_toUserIdTousers")
  notifications                                 Notification[]
  photos                                        Photo[]
  relationships_relationships_user1IdTousers    relationships[]         @relation("relationships_user1IdTousers")
  relationships_relationships_user2IdTousers    relationships[]         @relation("relationships_user2IdTousers")
  user_personality_profiles                     UserPersonalityProfile?
  preferences                                   UserPreferences?
  profile                                       UserProfile?
  user_quiz_responses                           UserQuizResponse[]

  // Safety and Security Relations
  safety_reports_made                           SafetyReport[]              @relation("ReporterUser")
  safety_reports_received                       SafetyReport[]              @relation("ReportedUser")
  blocked_users                                 UserBlock[]                 @relation("BlockingUser")
  blocked_by_users                              UserBlock[]                 @relation("BlockedUser")
  verification_requests                         VerificationRequest[]
  safety_check_ins                              SafetyCheckIn[]
  emergency_contacts                            EmergencyContact[]

  @@map("users")
}

