model UserPreferences {
  id           String   @id @default(cuid())
  userId       String   @unique
  minAge       Int      @default(18)
  maxAge       Int      @default(80)
  minHeight    Int?
  maxHeight    Int?
  maxDistance  Int      @default(50)
  education    String[]
  occupation   String[]
  interests    String[]
  dealBreakers String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model QuizCategory {
  id             String         @id @default(cuid())
  key            String         @unique
  name           String
  description    String?
  order_index    Int            @default(0)
  is_active      Boolean        @default(true)
  created_at     DateTime       @default(now())
  quiz_questions QuizQuestion[]

  @@map("quiz_categories")
}

model QuizQuestion {
  id                  String             @id @default(cuid())
  category_id         String
  question_key        String             @unique
  question_text       String
  question_type       String
  trait               String?
  reverse_scored      Boolean            @default(false)
  order_index         Int                @default(0)
  is_active           Boolean            @default(true)
  created_at          DateTime           @default(now())
  quiz_options        QuizOption[]
  quiz_categories     QuizCategory       @relation(fields: [category_id], references: [id], onDelete: Cascade)
  user_quiz_responses UserQuizResponse[]

  @@map("quiz_questions")
}

model QuizOption {
  id                  String             @id @default(cuid())
  question_id         String
  option_key          String
  option_text         String
  score_value         Int?
  order_index         Int                @default(0)
  created_at          DateTime           @default(now())
  quiz_questions      QuizQuestion       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  user_quiz_responses UserQuizResponse[]

  @@map("quiz_options")
}

model UserQuizResponse {
  id                 String       @id @default(cuid())
  user_id            String
  question_id        String
  selected_option_id String
  score              Int?
  completed_at       DateTime     @default(now())
  quiz_questions     QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)
  quiz_options       QuizOption   @relation(fields: [selected_option_id], references: [id], onDelete: Cascade)
  users              User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, question_id])
  @@map("user_quiz_responses")
}

model UserPersonalityProfile {
  id                      String    @id @default(cuid())
  user_id                 String    @unique
  openness_score          Int?
  conscientiousness_score Int?
  extraversion_score      Int?
  agreeableness_score     Int?
  neuroticism_score       Int?
  primary_love_language   String?
  secondary_love_language String?
  attachment_style        String?
  lifestyle_preferences   Json?
  matching_preferences    Json?
  completed_at            DateTime?
  updated_at              DateTime  @default(now())
  users                   User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_personality_profiles")
}

model Photo {
  id         String   @id @default(cuid())
  userId     String
  url        String
  isPrimary  Boolean  @default(false)
  order      Int      @default(0)
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model SystemSetting {
