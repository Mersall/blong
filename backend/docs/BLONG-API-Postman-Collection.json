      "name": "Health Checks",
      "item": [
        {
          "name": "Basic Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains status ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('Response contains message', function () {",
                  "    pm.expect(pm.response.json().message).to.exist;",
                  "});",
                  "",
                  "pm.test('Response contains timestamp', function () {",
                  "    pm.expect(pm.response.json().timestamp).to.exist;",
                  "});",
                  "",
                  "pm.test('Response contains version', function () {",
                  "    pm.expect(pm.response.json().version).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Detailed Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
